{
  "name": "dsh-deep-notebook",
  "version": "2.1.1",
  "description": "Deep Notebook: a notebook that turns every study action into a real DeepSeek Harness session, with a planned lesson map, learner memory, and progress reported back by the tutor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaFloraison/dsh-deep-notebook.git"
  },
  "homepage": "https://github.com/LaFloraison/dsh-deep-notebook",
  "bugs": { "url": "https://github.com/LaFloraison/dsh-deep-notebook/issues" },
  "type": "module",
  "main": "./lib/host.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "icon.svg", "LICENSE", "README.md", "CHANGELOG.md"],
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.2-rc.5 <0.3.0-0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "prepack": "node scripts/build.mjs"
  }
}
